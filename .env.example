# Optional: live group sharing. Without these, Waypoint still works fully and
# shares trips as a link or file instead.
# Vercel → Storage → Upstash Redis (free) adds KV_REST_API_URL / KV_REST_API_TOKEN automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Path the app is served under. Keep "/waypoint" to mount it in the portfolio.
# Set to an empty value to run it at the domain root.
WAYPOINT_BASE_PATH=/waypoint
